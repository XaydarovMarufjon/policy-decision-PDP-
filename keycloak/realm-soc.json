      "credentials": [
        { "type": "password", "value": "Passw0rd!", "temporary": false }
      ],
      "realmRoles": ["auditor"]
    },
    {
      "username": "vali.karimov",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Vali",
      "lastName": "Karimov",
      "email": "vali.karimov@hr.local",
