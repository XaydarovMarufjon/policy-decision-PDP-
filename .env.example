# PDP runtime
PDP_PORT=3000
OPA_DECISION_URL=http://opa:8181/v1/data/sentryx/zta/decision
OPA_TIMEOUT_MS=2000
CONTEXT_SOURCE_DIR=/app/mock-sources
PDP_AUDIT_LOG_PATH=/app/audit-logs/pdp-decisions.jsonl
# Max bytes read from the tail of the audit log per /pdp/audit request (bounded read).
# PDP_AUDIT_TAIL_BYTES=65536
# Rotate the local JSONL file at this size. Production may set REQUIRED=true so
# an authorization response is not returned unless its audit record persists.
PDP_AUDIT_MAX_BYTES=10485760
PDP_AUDIT_REQUIRED=false
# Optional central SIEM/collector endpoint and per-record tamper evidence.
# PDP_AUDIT_WEBHOOK_URL=https://siem.example.com/events/pdp
# PDP_AUDIT_WEBHOOK_TIMEOUT_MS=2000
# PDP_AUDIT_HMAC_SECRET=change-me-to-an-independent-long-random-string

# --- Security ---
# Shared secret required in the X-PDP-Auth header on /pdp/evaluate and /pdp/audit.
# The PEP and the (dev) admin console send it. REQUIRED — the PDP/PEP refuse to
# boot without it unless ALLOW_DEV_DEFAULTS=true. Use the same value on PDP and PEP.
PDP_SHARED_SECRET=change-me-to-a-long-random-string

# Allow the canonical (pre-resolved subject/device/risk/resource) request path.
# It bypasses identity verification, so it is DISABLED by default. Dev/test only.
ALLOW_CANONICAL_INPUT=false

# Permit built-in DEV default secrets and serve the admin console. Dev/test only.
# In production leave this unset/false so missing secrets fail closed and the
# console (which embeds the shared secret) is not served.
ALLOW_DEV_DEFAULTS=false

# PEP: trust proxy so request.ip is the real client IP behind a load balancer.
# Unset/false -> use the socket peer (not spoofable). "true" trusts all, or give
# a comma-separated CIDR list of known proxies.
# PEP_TRUST_PROXY=true
PEP_OUTBOUND_TIMEOUT_MS=4000
# Detailed context/route output is restricted to ALLOW_DEV_DEFAULTS=true.
PDP_DEBUG_RESPONSE=false

# PEP reverse proxy: upstream app served under /app/* after a PDP allow, and
# the resource id used when asking the PDP (must exist in opa/data/zta.json).
# The upstream must only be reachable through the PEP (no published ports).
# APP_UPSTREAM_URL=http://demo-app:5000
# APP_RESOURCE_ID=my_app

# --- Context signal sources (each pluggable, mock by default) ---
# Identity source for the subject (user).
#   mock  -> local mock-sources/identity.json  (default, no IdP needed)
#   oidc  -> real JWT verified against an Identity Provider's JWKS
IDENTITY_MODE=mock

# Risk source.
#   mock       -> mock-sources/risks.json
#   misp       -> live MISP threat-intel by source IP
#   wazuh      -> Wazuh SIEM score by source IP
#   wazuh-misp -> composite: Wazuh SIEM score + MISP threat-intel
RISK_MODE=mock

# Device posture source.  mock -> mock-sources/devices.json ; wazuh -> live Wazuh.
DEVICE_MODE=mock

# --- Wazuh (DEVICE_MODE=wazuh and/or RISK_MODE=wazuh|wazuh-misp) ---
# Server API (:55000, Basic->JWT) for agent posture; Indexer (:9200, Basic) for
# alerts & vulnerabilities. Both are self-signed TLS by default.
# WAZUH_API_URL=https://wazuh.example.com:55000
# WAZUH_API_USER=wazuh-wui
# WAZUH_API_PASSWORD=
# WAZUH_INDEXER_URL=https://wazuh.example.com:9200
# WAZUH_INDEXER_USER=admin
# WAZUH_INDEXER_PASSWORD=
# WAZUH_VERIFY_TLS=false          # true to enforce a valid cert
# WAZUH_TIMEOUT_MS=4000
# WAZUH_FAIL_OPEN=false           # true = Wazuh errors treated as benign (risky)
# WAZUH_STALE_MS=900000           # keepalive freshness window for edr healthy
# WAZUH_ALERTS_INDEX=wazuh-alerts-*
# WAZUH_VULN_INDEX=wazuh-states-vulnerabilities-*
# WAZUH_ALERTS_WINDOW=24h

# Resource inventory source.
#   opa-data (default) -> read from opa/data/zta.json so OPA is the single truth
#   mock               -> mock-sources/resources.json (test/dev only)
RESOURCE_MODE=opa-data
# Path to the OPA data file for RESOURCE_MODE=opa-data (baked into the image).
# OPA_DATA_FILE=opa/data/zta.json

# --- IDENTITY_MODE=oidc settings (real user) ---
# Expected token issuer (iss claim). Required for oidc.
# OIDC_ISSUER=https://keycloak.example.com/realms/soc
# Remote JWKS endpoint. Default: <issuer>/protocol/openid-connect/certs
# OIDC_JWKS_URL=https://keycloak.example.com/realms/soc/protocol/openid-connect/certs
# Local JWKS file for offline testing (overrides OIDC_JWKS_URL).
# OIDC_JWKS_FILE=dev-keys/jwks.json
# Expected audience (aud claim). REQUIRED in oidc mode (unless ALLOW_DEV_DEFAULTS=true,
# which only warns). Prevents accepting tokens minted for a different client.
OIDC_AUDIENCE=pdp
# Claim mapping (defaults shown are Keycloak-style).
# OIDC_CLAIM_USER=preferred_username
# OIDC_CLAIM_ROLE=realm_access.roles
# OIDC_ROLE_PRIORITY=admin,analyst,auditor,guest
# OIDC_DEFAULT_ROLE=
# OIDC_CLAIM_DEPARTMENT=department
# OIDC_DEFAULT_DEPARTMENT=
# OIDC_CLAIM_MFA=amr
# OIDC_MFA_MARKERS=mfa,otp,hwk,totp,mca,sms
# OIDC_MFA_ACR_VALUES=
