# PDP runtime
PDP_PORT=3000
OPA_DECISION_URL=http://opa:8181/v1/data/sentryx/zta/decision
CONTEXT_SOURCE_DIR=/app/mock-sources
PDP_AUDIT_LOG_PATH=/app/audit-logs/pdp-decisions.jsonl

# Identity source for the subject (user).
#   mock  -> local mock-sources/identity.json  (default, no IdP needed)
#   oidc  -> real JWT verified against an Identity Provider's JWKS
IDENTITY_MODE=mock

# --- IDENTITY_MODE=oidc settings (real user) ---
# Expected token issuer (iss claim). Required for oidc.
# OIDC_ISSUER=https://keycloak.example.com/realms/soc
# Remote JWKS endpoint. Default: <issuer>/protocol/openid-connect/certs
# OIDC_JWKS_URL=https://keycloak.example.com/realms/soc/protocol/openid-connect/certs
# Local JWKS file for offline testing (overrides OIDC_JWKS_URL).
# OIDC_JWKS_FILE=dev-keys/jwks.json
# Expected audience (aud claim), optional.
# OIDC_AUDIENCE=pdp
# Claim mapping (defaults shown are Keycloak-style).
# OIDC_CLAIM_USER=preferred_username
# OIDC_CLAIM_ROLE=realm_access.roles
# OIDC_ROLE_PRIORITY=admin,analyst,auditor,guest
# OIDC_DEFAULT_ROLE=
# OIDC_CLAIM_DEPARTMENT=department
# OIDC_DEFAULT_DEPARTMENT=
# OIDC_CLAIM_MFA=amr
# OIDC_MFA_MARKERS=mfa,otp,hwk,totp,mca,sms
# OIDC_MFA_ACR_VALUES=
